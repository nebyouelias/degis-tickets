// Degis Tickets — core data model (Phase 5: + organizer ownership & sales channel)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum EventCategory {
  CONCERT
  FOOTBALL
  FESTIVAL
  NIGHTLIFE
  COMEDY
  CONFERENCE
  CULTURAL
  CHURCH
  OTHER
}

enum TierKind {
  GA
  VIP
  VVIP
  EARLY_BIRD
  STUDENT
  TABLE
}

enum OrganizerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum EventReviewStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum BusinessType {
  SOLE_PROPRIETOR
  PLC
  SHARE_COMPANY
  NGO
  ASSOCIATION
  CHURCH
  GOVERNMENT
  OTHER
}

enum Role {
  ATTENDEE
  ORGANIZER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

enum OrderChannel {
  ONLINE
  BOX_OFFICE
}

enum ScanResult {
  ADMITTED
  DUPLICATE
  WRONG_EVENT
  INVALID_SIGNATURE
  EXPIRED_CODE
  VOID_TICKET
  UNKNOWN_TICKET
  OVERRIDE_ADMITTED
}

enum TicketStatus {
  VALID
  CHECKED_IN
  VOID
}

model User {
  id         String      @id @default(cuid())
  phone      String?     @unique
  email      String?     @unique
  name       String?
  role       Role        @default(ATTENDEE)
  orders     Order[]
  organizers Organizer[]
  createdAt  DateTime    @default(now())
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Organizer {
  id                String          @id @default(cuid())
  slug              String          @unique
  name              String // trading / display name
  status            OrganizerStatus @default(PENDING)
  verified          Boolean         @default(false)

  // Business identity
  legalName         String?
  businessType      BusinessType    @default(SOLE_PROPRIETOR)
  tin               String? // taxpayer identification number
  licenseNumber     String?
  licenseUrl        String? // uploaded trade licence document
  idDocUrl          String? // owner ID / passport
  city              String          @default("Addis Ababa")
  address           String?
  website           String?
  telegram          String?
  description       String?

  // Contact
  phone             String?
  email             String?
  contactName       String?

  // Payout details (settlement)
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?

  // Review trail
  reviewedAt        DateTime?
  reviewedById      String?
  reviewNote        String?

  owner             User?           @relation(fields: [ownerId], references: [id])
  ownerId           String?
  events            Event[]
  createdAt         DateTime        @default(now())

  @@index([ownerId])
  @@index([status])
}

model Venue {
  id      String  @id @default(cuid())
  name    String
  city    String  @default("Addis Ababa")
  address String?
  events  Event[]
}

model Event {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  titleAm     String?
  description String        @default("")
  category    EventCategory
  startsAt    DateTime
  coverImage  String
  published    Boolean          @default(false)
  reviewStatus EventReviewStatus @default(DRAFT)
  reviewNote   String?
  reviewedAt   DateTime?
  organizer   Organizer     @relation(fields: [organizerId], references: [id])
  organizerId String
  venue       Venue         @relation(fields: [venueId], references: [id])
  venueId     String
  tiers       TicketTier[]
  orders      Order[]
  tickets     Ticket[]
  devices     ScannerDevice[]
  pairings    PairingCode[]
  scans       ScanRecord[]
  createdAt   DateTime      @default(now())

  @@index([startsAt])
  @@index([category])
  @@index([organizerId])
  @@index([reviewStatus])
}

model TicketTier {
  id        String      @id @default(cuid())
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  name      String
  kind      TierKind    @default(GA)
  priceEtb  Int
  capacity  Int
  sold      Int         @default(0)
  sortOrder Int         @default(0)
  items     OrderItem[]
  tickets   Ticket[]
}

model Order {
  id            String       @id @default(cuid())
  user          User         @relation(fields: [userId], references: [id])
  userId        String
  event         Event        @relation(fields: [eventId], references: [id])
  eventId       String
  status        OrderStatus  @default(PENDING)
  channel       OrderChannel @default(ONLINE)
  subtotalEtb   Int
  serviceFeeEtb Int
  totalEtb      Int
  deliveryPhone String
  chapaTxRef    String       @unique
  paidAt        DateTime?
  expiresAt     DateTime
  paidSmsAt     DateTime?
  entrySmsAt    DateTime?
  items         OrderItem[]
  tickets       Ticket[]
  createdAt     DateTime     @default(now())

  @@index([status, expiresAt])
  @@index([userId, createdAt])
  @@index([eventId, status])
}

model OrderItem {
  id           String     @id @default(cuid())
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  tier         TicketTier @relation(fields: [tierId], references: [id])
  tierId       String
  quantity     Int
  unitPriceEtb Int
}

model Ticket {
  id          String       @id @default(cuid())
  code        String       @unique
  seq         Int
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  tier        TicketTier   @relation(fields: [tierId], references: [id])
  tierId      String
  event       Event        @relation(fields: [eventId], references: [id])
  eventId     String
  status      TicketStatus @default(VALID)
  checkedInAt DateTime?
  scans       ScanRecord[]
  createdAt   DateTime     @default(now())

  @@unique([orderId, seq])
  @@index([eventId, status])
}

model ScannerDevice {
  id         String       @id @default(cuid())
  event      Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String
  gate       String
  label      String?
  tokenHash  String       @unique
  active     Boolean      @default(true)
  lastSeenAt DateTime?
  scans      ScanRecord[]
  createdAt  DateTime     @default(now())

  @@index([eventId, active])
}

model PairingCode {
  id        String    @id @default(cuid())
  code      String    @unique
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  gate      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([eventId])
}

model ScanRecord {
  id           String        @id @default(cuid())
  clientScanId String        @unique // idempotent sync from offline devices
  ticket       Ticket?       @relation(fields: [ticketId], references: [id])
  ticketId     String?
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId      String
  device       ScannerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId     String
  gate         String
  result       ScanResult
  scannedAt    DateTime
  syncedAt     DateTime      @default(now())

  @@index([eventId, scannedAt])
  @@index([ticketId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // User.id of the admin or organizer who acted
  actorLabel String // denormalised for readability after account changes
  action     String // e.g. ORGANIZER_APPROVED, TICKET_VOIDED
  targetType String // Organizer | Event | Order | Ticket | User
  targetId   String
  note       String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}
