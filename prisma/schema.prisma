// Degis Tickets — core data model (Phase 3: + orders & payments)
// Phase 4 adds: Ticket (QR codes, wallet)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum EventCategory {
  CONCERT
  FOOTBALL
  FESTIVAL
  NIGHTLIFE
  COMEDY
  CONFERENCE
  CULTURAL
  CHURCH
  OTHER
}

enum TierKind {
  GA
  VIP
  VVIP
  EARLY_BIRD
  STUDENT
  TABLE
}

enum Role {
  ATTENDEE
  ORGANIZER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

model User {
  id        String   @id @default(cuid())
  phone     String?  @unique // E.164; set via OTP sign-in or added later
  email     String?  @unique // set via Google sign-in
  name      String?
  role      Role     @default(ATTENDEE)
  orders    Order[]
  createdAt DateTime @default(now())
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Organizer {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  verified  Boolean  @default(false)
  events    Event[]
  createdAt DateTime @default(now())
}

model Venue {
  id      String  @id @default(cuid())
  name    String
  city    String  @default("Addis Ababa")
  address String?
  events  Event[]
}

model Event {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  titleAm     String?
  description String        @default("")
  category    EventCategory
  startsAt    DateTime
  coverImage  String
  published   Boolean       @default(true)
  organizer   Organizer     @relation(fields: [organizerId], references: [id])
  organizerId String
  venue       Venue         @relation(fields: [venueId], references: [id])
  venueId     String
  tiers       TicketTier[]
  orders      Order[]
  createdAt   DateTime      @default(now())

  @@index([startsAt])
  @@index([category])
}

model TicketTier {
  id        String      @id @default(cuid())
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  name      String
  kind      TierKind    @default(GA)
  priceEtb  Int
  capacity  Int
  sold      Int         @default(0)
  sortOrder Int         @default(0)
  items     OrderItem[]
}

model Order {
  id            String      @id @default(cuid())
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  event         Event       @relation(fields: [eventId], references: [id])
  eventId       String
  status        OrderStatus @default(PENDING)
  subtotalEtb   Int
  serviceFeeEtb Int
  totalEtb      Int
  deliveryPhone String // E.164 — where tickets are sent
  chapaTxRef    String      @unique
  paidAt        DateTime?
  expiresAt     DateTime // pending orders release inventory after this
  items         OrderItem[]
  createdAt     DateTime    @default(now())

  @@index([status, expiresAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id           String     @id @default(cuid())
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  tier         TicketTier @relation(fields: [tierId], references: [id])
  tierId       String
  quantity     Int
  unitPriceEtb Int // snapshot of price at purchase time
}
